PORT=4310
# 用逗号分隔的允许 H5 管理端来源；生产环境只填 HTTPS 域名。
CORS_ORIGINS=https://stardust.sale
# 仅当部署在可信反向代理后开启，避免客户端伪造 X-Forwarded-For。
TRUST_PROXY=false
DATABASE_URL=postgresql://stardust_campus_circle:change-me@127.0.0.1:5432/stardust_campus_circle
UPLOAD_DIR=/var/lib/stardust-campus-circle/uploads
# 对外访问上传图片的 HTTPS 域名（可用逗号分隔）；社区与二手图片只接受这些本服务生成的地址。
UPLOAD_PUBLIC_ORIGIN=https://stardust.sale
# 生产必填：64 位十六进制或 32 字节 Base64。用于加密订单联系人、配送地址和 OpenID。
PII_ENCRYPTION_KEY=
# 生产必填：高熵随机值。用于生成不可逆的 OpenID 查找索引，不能复用 AppSecret。
IDENTITY_HASH_SECRET=
# 仅用于创建首个运营账号；日常授权使用微信会话 + 数据库角色，不要下发到客户端。
ADMIN_BOOTSTRAP_TOKEN=change-me
# 仅用于 127.0.0.1 本地后台预览；生产环境必须为 false 或不配置。
LOCAL_ADMIN_PREVIEW=false
# 仅本地兼容联调使用；生产环境必须为 false。
ALLOW_LEGACY_OPS_TOKEN=false
# 可接微信订阅消息、企业微信、短信聚合服务或自建通知网关。
# 未配置时通知会安全保留在 notification_outbox 的 pending 状态。
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
LUNCH_DELIVERY_FEE_CENTS=300
# 生产环境必须显式选择：wechat（在线微信支付）或 offline（线下/免支付）。
# 选择 wechat 时，缺少任一支付变量将拒绝启动，防止把收费订单错误当成免支付订单。
CHECKOUT_MODE=offline
# 生产环境必须配置微信小程序登录；不要把 AppSecret 放到客户端。
WECHAT_APPID=
WECHAT_APPSECRET=
# 用户生成文本的微信内容安全策略：生产必须为 required；observe 仅用于灰度观测，off 仅限本地开发。
WECHAT_CONTENT_SAFETY_MODE=required
# 部署后可运行 `npm run verify:wechat-credentials -- --env .env.production` 验证
# AppID/Secret 是否被微信接受。脚本不会输出、保存或写入 access_token。
SESSION_TTL_DAYS=14
# 仅本地联调时临时开启；生产环境必须为 false 或不配置。
ALLOW_DEVICE_AUTH=false
# 微信支付 API v3（只在服务端部署机的密钥目录配置；任一项缺失时自动保持免支付/线下结算模式）
WECHATPAY_APPID=
WECHATPAY_MCHID=
WECHATPAY_CERT_SERIAL_NO=
WECHATPAY_PRIVATE_KEY_PATH=
# 推荐：在商户平台申请微信支付公钥，填写公钥文件与公钥 ID（PUB_KEY_ID_...）。
WECHATPAY_PUBLIC_KEY_PATH=
WECHATPAY_PUBLIC_KEY_ID=
# 兼容旧的平台证书验签模式；与上面的微信支付公钥二选一。
WECHATPAY_PLATFORM_CERT_PATH=
WECHATPAY_PLATFORM_CERT_SERIAL_NO=
WECHATPAY_API_V3_KEY=
WECHATPAY_NOTIFY_URL=
# 可与支付回调共用；若单独配置，需在微信支付商户平台登记该退款回调地址。
WECHATPAY_REFUND_NOTIFY_URL=
PAYMENT_PENDING_MINUTES=15
# 可选：校园助手统一使用 DeepSeek 官方 API。未配置密钥时仍会回答运营知识库中的已核验内容。
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 课表图片识别使用 DeepSeek-OCR 的 OpenAI Chat Completions 兼容推理服务。
# 官方 DeepSeek 文本 API 不接收图片，因此这里必须填写独立部署或可信托管的 DeepSeek-OCR 地址。
DEEPSEEK_OCR_API_URL=
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=deepseek-ai/DeepSeek-OCR
# 课表整图优先使用更强的视觉模型；地址或密钥留空时自动复用上面的 OCR 服务。
# 视觉模型只调用整图，分栏与单元格精读仍由 DeepSeek-OCR 完成。
SCHEDULE_VISION_API_URL=
SCHEDULE_VISION_API_KEY=
SCHEDULE_VISION_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
# 可选：按学校所在城市自动获取实时天气。凭据只能配置在服务端。
# API Host 与 API Key 在和风天气开发者控制台创建；未配置时回退到运营后台维护的天气。
QWEATHER_API_HOST=
QWEATHER_API_KEY=
# 校园驿站或已签约物流服务商向本服务推送到件信息时使用的 HMAC 密钥。
# 未配置时学生仍可完成手机号绑定，但页面必须显示“等待驿站接入”，不会伪造自动同步。
EXPRESS_WEBHOOK_SECRET=
EXPRESS_PROVIDER_NAME=学校快递驿站
# 校园圈本地屏蔽词，逗号分隔；发布和评论命中后直接拒绝。未配置时使用代码内置列表。
COMMUNITY_BLOCKED_WORDS=兼职,钱,微信,微,jz,v,r
