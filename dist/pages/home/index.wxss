.home-page{--tenant-primary:#0b7a43;background:radial-gradient(circle at 8% 0,rgba(210,231,222,.5),transparent 275rpx),linear-gradient(180deg,#fbfcfb,#f4f7f5);padding-bottom:calc(118rpx + env(safe-area-inset-bottom))}.today-panel{background:linear-gradient(135deg,rgba(239,246,244,.98),rgba(247,249,255,.98));border:1rpx solid rgba(16,42,75,.08);border-radius:23rpx;box-shadow:0 12rpx 30rpx rgba(26,55,47,.07);padding:21rpx 19rpx 20rpx}.today-heading,.today-heading > view{align-items:center;display:flex}.today-heading{justify-content:space-between}.live-dot{background:#4fc56b;border-radius:50%;box-shadow:0 0 0 5rpx rgba(79,197,107,.12);height:8rpx;margin-right:8rpx;width:8rpx}.today-title{color:#17241f;font-size:29rpx;font-weight:900}.today-date{color:#7f8b85;font-size:21rpx}.today-grid{display:grid;gap:7rpx;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:18rpx}.today-item{align-items:center;background:hsla(0,0%,100%,.85);border:1rpx solid rgba(16,42,75,.055);border-radius:16rpx;display:flex;gap:8rpx;min-height:70rpx;min-width:0;padding:13rpx 8rpx}.today-item > view{display:grid;gap:3rpx;min-width:0}.today-symbol{border-radius:11rpx;display:grid;flex:0 0 auto;height:36rpx;place-items:center;width:36rpx}.today-symbol image{height:22rpx;width:22rpx}.symbol-green{background:#e3f5e8}.symbol-blue{background:#e5effa}.symbol-orange{background:#fff0df}.symbol-violet{background:#eee9f8}.today-label,.today-value{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.today-label{color:#78857f;font-size:18rpx}.today-value{color:#1f2a25;font-size:22rpx;font-weight:800}.section-block{background:hsla(0,0%,100%,.96);border:1rpx solid rgba(25,61,49,.065);border-radius:24rpx;box-shadow:0 12rpx 30rpx rgba(29,61,50,.055);margin-top:14rpx;padding:20rpx}.forum-heading,.section-head,.sheet-head{align-items:flex-start;display:flex;justify-content:space-between}.block-title{color:#17221e;display:block;font-size:33rpx;font-weight:900;letter-spacing:-.5rpx}.block-subtitle{color:#8d9993;display:block;font-size:21rpx;margin-top:4rpx}.head-action{color:#557166;font-size:23rpx;font-weight:700;padding:6rpx 0}.common-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin-top:18rpx;row-gap:20rpx}.common-item{align-items:center;display:flex;flex-direction:column;gap:9rpx;min-width:0}.common-icon,.picker-icon{border-radius:16rpx;box-shadow:inset 0 0 0 1rpx hsla(0,0%,100%,.5);display:grid;height:49rpx;place-items:center;width:49rpx}.tool-icon-image{height:25rpx;width:25rpx}.common-name{color:#26312c;font-size:22rpx;font-weight:650;max-width:100%;overflow:hidden;text-align:center;text-overflow:ellipsis;white-space:nowrap}.tone-mint{background:linear-gradient(145deg,#dff5e7,#edf9f1)}.tone-orange{background:linear-gradient(145deg,#ffe9d6,#fff3e8)}.tone-blue{background:linear-gradient(145deg,#e0eefb,#eef6fd)}.tone-lime{background:linear-gradient(145deg,#eef6d6,#f6f9e8)}.tone-violet{background:linear-gradient(145deg,#eee7f9,#f7f2fc)}.tone-yellow{background:linear-gradient(145deg,#fff0c9,#fff8e6)}.tone-pink{background:linear-gradient(145deg,#fbe3ec,#fff1f5)}.tone-cyan{background:linear-gradient(145deg,#dcf2f2,#ecf9f9)}.forum-heading{align-items:flex-end;margin:24rpx 4rpx 14rpx}.forum-heading > view{display:grid;gap:4rpx}.forum-title{color:#17221e;font-size:34rpx;font-weight:900}.forum-subtitle{color:#87948d;font-size:21rpx}.forum-enter{color:#3f6857;font-size:21rpx;font-weight:750;padding-bottom:2rpx}.home-forum-feed{display:grid;gap:13rpx}.feed-end{color:#98a39d;display:grid;gap:5rpx;padding:26rpx 0 8rpx;text-align:center}.feed-end text:first-child{color:#d1a13b;font-size:19rpx}.feed-end text:last-child{font-size:20rpx}.ai-float{align-items:center;backdrop-filter:blur(14rpx);background:rgba(16,42,75,.95);border:1rpx solid hsla(0,0%,100%,.3);border-radius:999rpx;bottom:calc(76rpx + env(safe-area-inset-bottom));box-shadow:0 12rpx 28rpx rgba(16,42,75,.22);color:#fff;display:flex;gap:8rpx;padding:8rpx 14rpx 8rpx 8rpx;position:fixed;right:20rpx;z-index:40}.ai-orbit{background:#e9f4dc;border-radius:50%;display:grid;height:36rpx;place-items:center;width:36rpx}.ai-orbit image{height:20rpx;width:20rpx}.ai-float > view:last-child{display:grid;gap:1rpx}.ai-float > view:last-child text:first-child{font-size:21rpx;font-weight:800}.ai-float > view:last-child text:last-child{color:hsla(0,0%,100%,.72);font-size:16rpx}.modal-mask{align-items:flex-end;background:rgba(7,20,32,.42);display:flex;inset:0;padding:0 20rpx;position:fixed;z-index:90}.sheet{background:#fff;border-radius:28rpx 28rpx 0 0;max-height:78vh;padding:25rpx 22rpx calc(34rpx + env(safe-area-inset-bottom));width:100%}.sheet-head > view{display:grid;gap:4rpx}.sheet-head > view text:first-child{font-size:24rpx;font-weight:900}.sheet-head > view text:last-child{color:#7f8982;font-size:14rpx}.sheet-head > text{color:#0b8743;font-size:17rpx;font-weight:700}.tool-picker{display:grid;gap:10rpx;grid-template-columns:1fr 1fr;margin-top:20rpx}.picker-item{align-items:center;border:1rpx solid #e5e9e6;border-radius:17rpx;color:#303632;display:flex;font-size:16rpx;gap:9rpx;min-height:64rpx;padding:10rpx;position:relative}.picker-item.selected{background:#f0f8f2;border-color:#67ae82}.picker-icon{border-radius:12rpx;height:36rpx;width:36rpx}.picker-state{color:#0b8a43;font-weight:800;position:absolute;right:12rpx}@media (max-width:370px){.today-grid{grid-template-columns:1fr 1fr}.today-item{min-height:62rpx}}