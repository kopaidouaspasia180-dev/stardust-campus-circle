.profile-hero{align-items:center;display:flex;gap:22rpx;padding:38rpx 10rpx}.profile-avatar{background:#0f6a50;border-radius:36rpx;color:#fff;display:grid;font-size:42rpx;font-weight:900;height:104rpx;place-items:center;width:104rpx}.profile-hero > view:last-child{display:grid;gap:8rpx}.profile-hero > view:last-child text:first-child{font-size:34rpx;font-weight:900}.profile-hero > view:last-child text:last-child{color:#7d8780;font-size:22rpx}.profile-school{align-items:center;display:flex;justify-content:space-between;padding:27rpx}.profile-school > view{display:grid;gap:5rpx}.profile-school > view text:first-child{color:#89918c;font-size:20rpx}.profile-school > view text:last-child{font-size:28rpx;font-weight:800}.profile-school > text{color:#0f6a50;font-size:23rpx}.profile-menu{margin-top:20rpx;overflow:hidden}.profile-menu > view{align-items:center;border-bottom:1rpx solid #eef0ee;display:flex;font-size:25rpx;justify-content:space-between;padding:26rpx 28rpx}.profile-menu > view:last-child{border-bottom:0}.profile-menu > view text:last-child{color:#a1a7a3}.profile-version{color:#9aa19c;display:block;font-size:19rpx;margin-top:30rpx;text-align:center}