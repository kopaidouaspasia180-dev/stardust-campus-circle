.community-page{background:radial-gradient(circle at 8% 2%,rgba(215,232,225,.52),transparent 280rpx),#f5f7f5;padding-bottom:calc(88rpx + env(safe-area-inset-bottom))}.community-head{align-items:center;display:flex;justify-content:space-between;margin-top:15rpx}.community-head > view{display:grid;gap:5rpx}.community-title{color:#17221e;font-size:39rpx;font-weight:900}.community-subtitle{color:#829087;font-size:22rpx}.publish-button{background:#0b7a43;border-radius:999rpx;color:#fff;font-size:26rpx;font-weight:800;height:47rpx;line-height:47rpx;margin:0;width:150rpx}.channel-row{margin:19rpx -18rpx 0;overflow-x:auto;padding:0 18rpx 9rpx;white-space:nowrap}.channel-row text{border-radius:999rpx;color:#617068;display:inline-block;font-size:22rpx;font-weight:650;margin-right:8rpx;padding:8rpx 14rpx}.channel-row text.active{background:#0b7a43;color:#fff}.community-feed{display:grid;gap:13rpx}.community-empty{background:#fff;border-radius:22rpx;color:#7d8982;display:grid;gap:7rpx;margin-top:14rpx;padding:70rpx 20rpx;text-align:center}.community-empty text:first-child{color:#334039;font-size:27rpx;font-weight:800}.community-source{color:#8b9690;display:block;font-size:18rpx;line-height:1.6;margin:18rpx 5rpx 0;text-align:center}