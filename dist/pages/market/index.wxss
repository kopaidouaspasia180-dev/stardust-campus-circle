.market-preview{border-radius:16rpx;height:260rpx;width:100%}.market-grid{display:grid;gap:12rpx;grid-template-columns:1fr 1fr}.market-card{min-width:0}.market-card > image,.market-placeholder{border-radius:14rpx;height:210rpx;margin-bottom:12rpx;width:100%}.market-placeholder{background:#eaf4ed;color:#0b7a43;display:grid;font-size:54rpx;font-weight:900;place-items:center}.market-bottom{align-items:center;display:flex;justify-content:space-between;margin-top:12rpx}.market-bottom > text:last-child{color:#0b7a43;font-size:20rpx}