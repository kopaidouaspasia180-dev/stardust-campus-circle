.publish-page{background:radial-gradient(circle at 90% 0,rgba(215,232,225,.6),transparent 270rpx),#f5f7f5;padding-bottom:calc(42rpx + env(safe-area-inset-bottom))}.publish-kicker{color:#b48b2d;display:block;font-size:19rpx;font-weight:800;letter-spacing:3rpx;margin-top:12rpx}.publish-title{display:block;font-size:36rpx;font-weight:900;margin-top:7rpx}.publish-tip{color:#829087;display:block;font-size:21rpx;margin-top:7rpx}.topic-row{margin:22rpx -18rpx 0;overflow-x:auto;padding:0 18rpx 13rpx;white-space:nowrap}.topic-row text{background:#fff;border-radius:999rpx;color:#68736b;display:inline-block;font-size:23rpx;margin-right:9rpx;padding:9rpx 15rpx}.topic-row text.active{background:#0b7a43;color:#fff}.publish-box{padding:20rpx}.publish-box textarea{color:#26312c;font-size:27rpx;line-height:1.7;min-height:190rpx;width:100%}.upload-entry{align-content:center;background:#f8faf8;border:1rpx dashed #c6d0c9;border-radius:17rpx;color:#748178;display:grid;font-size:21rpx;gap:1rpx;height:100rpx;margin-top:15rpx;place-items:center;width:118rpx}.upload-entry text:first-child{color:#0b7a43;font-size:29rpx;line-height:1}.selected-image-wrap{border-radius:18rpx;height:200rpx;margin-top:15rpx;overflow:hidden;position:relative;width:100%}.selected-image{height:100%;width:100%}.remove-image{background:rgba(18,28,23,.72);border-radius:999rpx;color:#fff;font-size:13rpx;padding:6rpx 11rpx;position:absolute;right:11rpx;top:11rpx}.location-row{align-items:center;border-bottom:1rpx solid #edf0ed;border-top:1rpx solid #edf0ed;color:#0b7a43;display:flex;gap:8rpx;margin-top:17rpx;padding:13rpx 0}.location-row input{color:#425048;flex:1;font-size:23rpx}.publish-meta{color:#89928c;display:flex;font-size:19rpx;justify-content:space-between;margin-top:15rpx}.publish-rules{background:#eaf1ed;border-radius:19rpx;display:grid;gap:6rpx;margin-top:15rpx;padding:17rpx}.publish-rules text:first-child{color:#36463d;font-size:23rpx;font-weight:800}.publish-rules text:last-child{color:#6d7c73;font-size:19rpx;line-height:1.6}.publish-submit{background:#0b7a43;border-radius:18rpx;color:#fff;font-size:27rpx;font-weight:800;height:52rpx;line-height:52rpx;margin-top:20rpx}