.post-detail-page{background:#f5f7f5;padding-bottom:calc(92rpx + env(safe-area-inset-bottom))}.post-detail-page .post-content{display:block;-webkit-line-clamp:unset;overflow:visible}.comment-section{background:#fff;border-radius:22rpx;margin-top:14rpx;padding:19rpx}.comment-title-row{align-items:center;display:flex;justify-content:space-between}.comment-title-row text:first-child{color:#1d2923;font-size:29rpx;font-weight:900}.comment-title-row text:last-child{color:#89948e;font-size:20rpx}.comment-list{margin-top:6rpx}.comment-item{border-bottom:1rpx solid #edf0ed;display:grid;gap:10rpx;grid-template-columns:38rpx 1fr;padding:15rpx 0}.comment-avatar{background:#e8f3eb;border-radius:12rpx;color:#0b7a43;display:grid;font-size:15rpx;font-weight:900;height:38rpx;place-items:center;width:38rpx}.comment-meta{align-items:center;display:flex;justify-content:space-between}.comment-meta text:first-child{color:#415048;font-size:22rpx;font-weight:800}.comment-meta text:last-child{color:#9aa39e;font-size:18rpx}.comment-content{color:#39443e;display:block;font-size:24rpx;line-height:1.55;margin-top:6rpx}.no-comment{color:#929d97;display:block;font-size:22rpx;padding:38rpx 0 24rpx;text-align:center}.comment-composer{background:hsla(0,0%,100%,.97);border-top:1rpx solid rgba(25,61,49,.08);bottom:0;display:grid;gap:9rpx;grid-template-columns:1fr 78rpx;left:0;padding:10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));position:fixed;right:0;z-index:50}.comment-composer input{background:#f1f4f2;border-radius:15rpx;font-size:23rpx;height:44rpx;padding:0 15rpx}.comment-composer button{background:#0b7a43;border-radius:15rpx;color:#fff;font-size:23rpx;font-weight:800;height:44rpx;line-height:44rpx;margin:0;width:78rpx}