.school-kicker{color:#0f6a50;display:block;font-size:20rpx;font-weight:900;letter-spacing:3rpx;margin-top:15rpx}.school-title{display:block;font-size:44rpx;font-weight:900;margin-top:12rpx}.school-copy{color:#78827b;display:block;font-size:23rpx;line-height:1.6;margin-top:12rpx}.school-search{align-items:center;display:flex;gap:14rpx;margin-top:28rpx;padding:20rpx 24rpx}.school-search text{color:#7e8781;font-size:32rpx}.school-search input{flex:1;font-size:24rpx}.school-list{display:grid;gap:14rpx;margin-top:20rpx}.school-item{align-items:center;display:flex;gap:18rpx;padding:22rpx}.school-item.current{border:2rpx solid #7ab59e}.school-mark{border-radius:24rpx;color:#fff;display:grid;flex:0 0 auto;font-size:31rpx;font-weight:900;height:76rpx;place-items:center;width:76rpx}.school-info{display:grid;flex:1;gap:7rpx;min-width:0}.school-info text:first-child{font-size:28rpx;font-weight:850;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.school-info text:last-child{color:#89918c;font-size:20rpx}.school-state{color:#0f6a50;display:grid;font-size:20rpx;gap:5rpx;justify-items:end}