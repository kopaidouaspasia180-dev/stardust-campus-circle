.new-kicker{color:#9a7138;display:block;font-size:19rpx;font-weight:900;letter-spacing:3rpx;margin-top:20rpx}.new-heading{display:block;font-size:42rpx;font-weight:900;margin-top:13rpx}.new-intro{color:#7d867f;display:block;font-size:23rpx;line-height:1.7;margin-top:14rpx}.topic-list{display:grid;gap:15rpx;margin-top:30rpx}.topic-card{align-items:center;display:grid;gap:18rpx;grid-template-columns:68rpx 1fr 20rpx;padding:24rpx}.topic-card > text:first-child{background:#0f6a50;border-radius:22rpx;color:#fff;display:grid;font-size:21rpx;font-weight:900;height:68rpx;place-items:center;width:68rpx}.topic-card > view{display:grid;gap:7rpx}.topic-card > view text:first-child{font-size:29rpx;font-weight:900}.topic-card > view text:last-child{color:#818a84;font-size:21rpx}.topic-card > text:last-child{color:#9ba19d;font-size:32rpx}