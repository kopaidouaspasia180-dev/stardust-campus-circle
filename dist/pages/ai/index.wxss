.ai-page{padding-bottom:70rpx}.ai-title-row{align-items:center;display:flex;gap:14rpx;margin-top:22rpx}.ai-orb{background:#153457;border:5rpx solid #dff1df;border-radius:50%;box-shadow:0 10rpx 24rpx rgba(13,54,78,.18);color:#b8ef31;display:grid;height:62rpx;place-items:center;width:62rpx}.ai-title-row > view:last-child{display:grid;gap:4rpx}.ai-title-row > view:last-child text:first-child{font-size:32rpx;font-weight:900}.ai-title-row > view:last-child text:last-child{color:#7b867e;font-size:18rpx}.chat-card{margin-top:24rpx;padding:24rpx;text-align:left}.chat-card text{color:#37423b;font-size:21rpx;line-height:1.7}.ai-suggestions{display:flex;flex-wrap:wrap;gap:9rpx;margin-top:17rpx}.ai-suggestions text{background:#fff;border-radius:999rpx;color:#3e6552;font-size:17rpx;padding:10rpx 14rpx}.ai-compose{align-items:center;display:flex;margin-top:20rpx;padding:9rpx 9rpx 9rpx 19rpx}.ai-compose input{flex:1;font-size:20rpx}.ai-compose button{background:#0b7a43;border-radius:18rpx;color:#fff;font-size:19rpx;margin:0;width:96rpx}.ai-demo-note{color:#929a95;display:block;font-size:15rpx;margin-top:15rpx;text-align:center}