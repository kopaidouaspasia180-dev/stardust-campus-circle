.messages-kicker{color:#b48b2d;display:block;font-size:18rpx;font-weight:800;letter-spacing:3rpx;margin-top:12rpx}.messages-title{display:block;font-size:39rpx;font-weight:900;margin-top:8rpx}.message-list{margin-top:24rpx;overflow:hidden}.message-row{align-items:center;border-bottom:1rpx solid #edf0ed;display:flex;gap:14rpx;padding:22rpx}.message-row:last-child{border-bottom:0}.message-icon{background:#eef7f0;border-radius:16rpx;color:#0b7a43;display:grid;font-size:24rpx;height:48rpx;place-items:center;width:48rpx}.message-copy{display:grid;flex:1;gap:5rpx;min-width:0}.message-copy text:first-child{font-size:21rpx;font-weight:800}.message-copy text:last-child{color:#7f8982;font-size:17rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.message-time{color:#9aa29d;font-size:14rpx}