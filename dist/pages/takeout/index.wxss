.takeout-notice{background:#fff5df;border-radius:16rpx;color:#7b5a21;font-size:20rpx;line-height:1.5;padding:14rpx 16rpx}.merchant-head{align-items:flex-start;display:flex;justify-content:space-between;margin:0 4rpx 12rpx}.merchant-head > view{display:grid;gap:4rpx}.merchant-head > view text:first-child{font-size:30rpx;font-weight:900}.merchant-head > view text:last-child{color:#7d8982;font-size:20rpx}.merchant-head > text{color:#0b7a43;font-size:20rpx}.product-card{align-items:center;display:flex;gap:12rpx;justify-content:space-between}.product-card > view:first-child{flex:1}.quantity{align-items:center;display:flex;gap:12rpx}.quantity text:first-child,.quantity text:last-child{background:#edf7f0;border-radius:50%;color:#0b7a43;display:grid;font-size:28rpx;height:42rpx;place-items:center;width:42rpx}.quantity text:nth-child(2){font-size:22rpx;min-width:24rpx;text-align:center}.cart-bar{align-items:center;background:hsla(0,0%,100%,.97);border-top:1rpx solid #e5ebe7;bottom:0;display:flex;justify-content:space-between;margin:20rpx -18rpx -54rpx;padding:12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));position:sticky;z-index:5}.cart-bar > view{display:grid;gap:2rpx}.cart-bar > view text:first-child{color:#7d8982;font-size:18rpx}.cart-bar > view text:last-child{color:#f05b35;font-size:32rpx;font-weight:900}.cart-bar button{background:#0b7a43;border-radius:999rpx;color:#fff;font-size:24rpx;margin:0;width:190rpx}