.services-page{padding-bottom:120rpx}.services-heading{align-items:flex-end;display:flex;justify-content:space-between;margin:12rpx 4rpx 20rpx}.services-heading text:first-child{font-size:38rpx;font-weight:900}.services-heading text:last-child{color:#7e8981;font-size:23rpx}.service-search{align-items:center;display:flex;gap:12rpx;padding:16rpx 20rpx}.service-search text{color:#587065;font-size:27rpx}.service-search input{flex:1;font-size:25rpx}.service-tabs{margin:18rpx -28rpx 16rpx;overflow-x:auto;padding:0 28rpx 8rpx;white-space:nowrap}.service-tabs text{background:#fff;border-radius:999rpx;color:#707b73;display:inline-block;font-size:23rpx;margin-right:8rpx;padding:9rpx 16rpx}.service-tabs text.active{background:#0b7a43;color:#fff}.service-grid{display:grid;gap:12rpx;grid-template-columns:1fr 1fr}.service-card{display:flex;flex-direction:column;min-height:180rpx;padding:20rpx}.service-icon{background:#eff8f1;border-radius:14rpx;color:#0b7a43;display:grid;font-size:28rpx;height:44rpx;place-items:center;width:44rpx}.service-name{font-size:28rpx;font-weight:900;margin-top:12rpx}.service-sub{color:#78827b;font-size:23rpx;line-height:1.45;margin-top:6rpx}.service-status{color:#0b7a43;font-size:22rpx;font-weight:700;margin-top:auto}