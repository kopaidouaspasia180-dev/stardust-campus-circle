.rankings-page{background:radial-gradient(circle at 92% 3%,rgba(222,238,228,.78),transparent 260rpx),#f5f7f5;padding-bottom:100rpx}.rankings-hero{background:linear-gradient(135deg,#102a4b,#173e45 65%,#1f6a50);border-radius:26rpx;box-shadow:0 16rpx 34rpx rgba(16,42,75,.16);color:#fff;margin-top:6rpx;overflow:hidden;padding:25rpx 22rpx 23rpx;position:relative}.rankings-hero::after{border:1rpx solid hsla(0,0%,100%,.15);border-radius:50%;bottom:-55rpx;box-shadow:0 0 0 24rpx hsla(0,0%,100%,.04),0 0 0 48rpx hsla(0,0%,100%,.025);content:"";height:170rpx;position:absolute;right:-25rpx;width:170rpx}.rankings-kicker{color:#d9c27a;display:block;font-size:18rpx;font-weight:800;letter-spacing:2rpx}.rankings-title{display:block;font-size:36rpx;font-weight:900;margin-top:8rpx}.rankings-intro{color:hsla(0,0%,100%,.78);display:block;font-size:22rpx;line-height:1.58;margin-top:9rpx;max-width:300rpx}.hero-badges{display:flex;gap:8rpx;margin-top:18rpx}.hero-badges text{background:hsla(0,0%,100%,.08);border:1rpx solid hsla(0,0%,100%,.18);border-radius:999rpx;font-size:18rpx;font-weight:700;padding:6rpx 10rpx}.ranking-section{background:hsla(0,0%,100%,.96);border:1rpx solid rgba(25,61,49,.065);border-radius:24rpx;box-shadow:0 12rpx 30rpx rgba(29,61,50,.055);margin-top:16rpx;padding:20rpx}.ranking-heading{align-items:flex-start;display:flex;justify-content:space-between}.ranking-heading > view{display:grid;gap:4rpx}.ranking-heading > view text:first-child{color:#19241f;font-size:31rpx;font-weight:900}.ranking-heading > view text:last-child{color:#8c9892;font-size:20rpx}.ranking-heading > text{color:#cfd9d3;font-size:27rpx;font-weight:900}.ranking-winner{border-radius:19rpx;height:176rpx;margin-top:15rpx;overflow:hidden;position:relative}.ranking-winner > image,.winner-shade{height:100%;inset:0;position:absolute;width:100%}.winner-shade{background:linear-gradient(180deg,rgba(7,19,29,.02) 20%,rgba(7,19,29,.78))}.winner-badge{background:#f6dc82;border-radius:9rpx;color:#5d4918;font-size:18rpx;font-weight:900;left:12rpx;padding:6rpx 9rpx;position:absolute;top:12rpx}.winner-copy{bottom:14rpx;color:#fff;display:grid;gap:4rpx;left:15rpx;position:absolute;right:15rpx}.winner-copy text:first-child{font-size:28rpx;font-weight:900}.winner-copy text:last-child{color:hsla(0,0%,100%,.72);font-size:19rpx}.ranking-list{margin-top:7rpx}.ranking-row{align-items:center;border-bottom:1rpx solid #edf0ed;display:grid;gap:10rpx;grid-template-columns:35rpx 1fr auto;padding:14rpx 1rpx}.ranking-row:last-child{border-bottom:0;padding-bottom:2rpx}.ranking-number{background:#edf2ef;border-radius:10rpx;color:#496156;display:grid;font-size:14rpx;font-weight:900;height:30rpx;place-items:center;width:30rpx}.number-2{background:#e9eef3;color:#52677b}.number-3{background:#f6eae0;color:#9b6036}.ranking-row > view{display:grid;gap:3rpx}.ranking-row > view text:first-child{color:#28332d;font-size:25rpx;font-weight:800}.ranking-row > view text:last-child{color:#8a9690;font-size:19rpx}.ranking-row > text:last-child{color:#517165;font-size:20rpx;font-weight:700}.ranking-gallery{display:grid;gap:10rpx;grid-template-columns:1fr 1fr;margin-top:16rpx}.ranking-gallery image{border-radius:18rpx;height:105rpx;width:100%}.rankings-note{background:#eaf1ed;border-radius:17rpx;color:#64776d;display:block;font-size:20rpx;line-height:1.65;margin-top:15rpx;padding:16rpx}