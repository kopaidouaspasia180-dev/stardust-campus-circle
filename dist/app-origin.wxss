page{background:#f4f7f5;color:#17221e;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Microsoft YaHei,sans-serif;font-size:24rpx;min-height:100%;overflow-x:hidden}*,button,image,input,text,textarea,view{box-sizing:border-box}#app,.taro-tabbar__container,body,html{max-width:100vw;overflow-x:hidden;width:100%}button::after{border:0}.page{margin:0 auto;max-width:100vw;min-height:100vh;overflow-x:hidden;padding:10rpx 18rpx calc(50rpx + env(safe-area-inset-bottom));width:100%}.section{margin-top:26rpx}.section-title{align-items:flex-end;display:flex;justify-content:space-between;margin-bottom:16rpx}.section-title text:first-child{font-size:30rpx;font-weight:800}.section-title text:last-child{color:#879089;font-size:18rpx}.card{background:#fff;border:1rpx solid rgba(26,77,59,.06);border-radius:22rpx}.empty{color:#859088;padding:70rpx 30rpx;text-align:center}.taro-tabbar__tabbar,.weui-tabbar{backdrop-filter:blur(18rpx);background:hsla(0,0%,100%,.96)!important;border-top:1rpx solid rgba(25,61,49,.06)!important;box-shadow:0 -1rpx 8rpx rgba(24,55,44,.035)!important;height:calc(50rpx + env(safe-area-inset-bottom))!important;min-height:50rpx!important;padding-bottom:env(safe-area-inset-bottom)!important;width:100%!important}.weui-tabbar__item{color:#7e8983!important;font-size:17rpx!important;min-height:50rpx!important;padding:4rpx 0 3rpx!important}.weui-tabbar__item.weui-bar__item_on{color:#0b7a43!important}.weui-tabbar__icon{height:20rpx!important;margin-bottom:1rpx!important;width:20rpx!important}